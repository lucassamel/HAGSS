@page "/"
@implements IDisposable
@inject ActivityFeed Feed

<div class="toolbar">
    <span class="badge @ConnectionClass">@Feed.ConnectionState</span>
    <span class="live-indicator @(Feed.ConnectionState == "Connected" ? "active" : "")">LIVE</span>
    <span class="meta">Last event: @(Feed.Stats.LastEventAtUtc?.ToString("u") ?? "—")</span>
</div>

<StatsPanel/>
<SeatsPanel/>
<LiveFeedPanel @ref="_liveFeed"/>

@code {
    private LiveFeedPanel? _liveFeed;

    private string ConnectionClass => Feed.ConnectionState switch
    {
        "Connected" => "online",
        "Reconnecting" => "reconnecting",
        _ => "offline"
    };

    protected override void OnInitialized() => Feed.Changed += OnFeedChanged;

    private void OnFeedChanged()
    {
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            if (_liveFeed is not null)
                await _liveFeed.OnFeedUpdatedAsync();
        });
    }

    public void Dispose() => Feed.Changed -= OnFeedChanged;
}
